{
  "name": "arma-mcp-server",
  "version": "0.5.14",
  "private": true,
  "description": "Arma 3 MCP server — SQF exec, mission telemetry, RPT tools, launcher",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=bundle/index.mjs --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "test": "tsx --test test/*.test.ts",
    "fake": "tsx test/fake_dll.ts",
    "smoke": "tsx test/mcp_smoke.ts",
    "bench": "tsx test/bench_latency.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
